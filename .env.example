# Python API. Keep real credentials out of Git.
ROLEREADY_ENVIRONMENT=development
ROLEREADY_AUTH_MODE=local
ROLEREADY_LOCAL_TOKEN=local-development
# llm requires a generator. Explicit retrieval mode is available for data exploration.
ROLEREADY_QUESTION_MODE=llm
ROLEREADY_RETRIEVER=bge
# OpenAI-compatible base URLs, including /v1. Configure separate model servers.
ROLEREADY_GENERATION_URL=
ROLEREADY_GENERATION_KEY=
ROLEREADY_GENERATION_MODEL=Qwen/Qwen3.5-4B
ROLEREADY_EVALUATION_URL=
ROLEREADY_EVALUATION_KEY=
ROLEREADY_EVALUATION_MODEL=prometheus-eval/prometheus-7b-v2.0
ROLEREADY_VOICE_ENABLED=false
ROLEREADY_SUPABASE_URL=
ROLEREADY_SUPABASE_ANON_KEY=
# Leave unset for local SQLite MLflow. Shell environment is used by pipeline commands.
# MLFLOW_TRACKING_URI=https://dagshub.com/OWNER/REPO.mlflow
# MLFLOW_TRACKING_USERNAME=YOUR_DAGSHUB_USERNAME
# MLFLOW_TRACKING_PASSWORD=YOUR_DAGSHUB_TOKEN
# MLFLOW_EXPERIMENT_NAME=roleready
